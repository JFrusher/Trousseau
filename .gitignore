# Personal wedding data — never commit.
# Anchored to the root: data/ is the canonical home and is handled by DVC,
# which writes its own data/.gitignore. An unanchored *.trousseau.json here
# would match that file too, and `dvc add` refuses a git-ignored path.
/*.trousseau.json
unpacked/

# Per-device path to the OneDrive folder the apps write into.
.working-path
