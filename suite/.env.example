# Sharing and sync. Leave all of this unset and the suite is exactly what it
# was: local-first, no account, nothing leaving the device. Only publishing a
# guest link and syncing between machines need a backend.
#
# Everything stored server-side is ciphertext. These credentials give access to
# bytes that cannot be decrypted without a passphrase this server never sees.

SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Accounts and cloud storage. `accountsConfigured()` in lib/env.ts requires all
# three of SUPABASE_URL, NEXT_PUBLIC_SUPABASE_URL and
# NEXT_PUBLIC_SUPABASE_ANON_KEY. Set fewer than three and the account routes
# answer 501 and the sign-in page says accounts are not set up on this
# deployment — which is correct behaviour for a deliberately local-only
# instance, and baffling if you meant to enable accounts.
#
# NEXT_PUBLIC_SUPABASE_URL is the same value as SUPABASE_URL, duplicated under
# a NEXT_PUBLIC_ name because the browser bundle can only read variables with
# that prefix.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Development only: run the sync endpoints against a process-local map instead
# of a database. State vanishes on restart. Never set this in production — an
# unconfigured backend must fail loudly rather than quietly accept a wedding
# into memory that disappears on the next deploy.
# SYNC_IN_MEMORY=1

# SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY are both-or-neither. A URL with no
# key used to answer 501 exactly like a deliberate local-only deploy; it now
# fails the build instead.

# Error reporting. Unset means no Sentry, in the browser or on the server.
# A DSN identifies a project rather than authorising anything, so this one is
# deliberately public.
# NEXT_PUBLIC_SENTRY_DSN=

# Retention sweep. A shared secret Vercel Cron presents as a bearer token;
# unset means the sweep endpoint refuses everything, including Vercel. An
# endpoint whose job is deleting fails closed.
# CRON_SECRET=
